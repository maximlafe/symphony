# Compose interpolation values for staging on a shared VPS host.
# This stack is isolated from production by project/container names, host paths, and port.
SYMPHONY_COMPOSE_PROJECT=symphony-staging
SYMPHONY_IMAGE=ghcr.io/maximlafe/symphony:sha-REPLACE_ME
SYMPHONY_CONTAINER_NAME=symphony-staging

CODEX_HOME=/root/.codex
SYMPHONY_CODEX_HOME_HOST_PATH=/srv/symphony-staging/codex-home

SYMPHONY_WORKFLOW_HOST_PATH=/srv/symphony-staging/workflows
SYMPHONY_WORKFLOW_PATH=/srv/symphony-staging/workflows/WORKFLOW.md

SYMPHONY_PORT=4102
SYMPHONY_SERVER_HOST=0.0.0.0
SYMPHONY_SERVER_PATH=/proxy/symphony-staging
SYMPHONY_PUBLIC_HOST=stream.cash
SYMPHONY_PUBLIC_PATH=/proxy/symphony-staging

SYMPHONY_WORKSPACE_ROOT=/srv/symphony/workspaces
SYMPHONY_WORKSPACE_HOST_PATH=/srv/symphony-staging/workspaces
SYMPHONY_LOGS_ROOT=/srv/symphony/logs
SYMPHONY_LOGS_HOST_PATH=/srv/symphony-staging/logs

SYMPHONY_SOURCE_REPO_URL=https://github.com/maximlafe/symphony.git
SYMPHONY_RUNTIME_ENV_FILE=/etc/symphony-staging/symphony.env
SYMPHONY_REQUIRED_ENV_VARS=LINEAR_API_KEY GH_TOKEN OPENAI_API_KEY SYMPHONY_SECRET_KEY_BASE SYMPHONY_PUBLIC_HOST
